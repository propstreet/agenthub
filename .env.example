# AgentHub Environment Configuration

# Server Configuration
PORT=3333
HOST=localhost

# Logging Configuration
# Set to 'debug' for verbose HTTP request/response logging (default: 'info')
LOG_LEVEL=info

# Filesystem Watcher (optional)
# Path to watch for file changes - set this to your project root
# If not set, filesystem watching will be disabled
WATCH_ROOT=

# Azure OpenAI Configuration (optional)
# Required for expert escalation (expert.ask operation)
# If not set, expert escalation will return an error

# Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=

# API Key authentication (recommended for development)
AZURE_OPENAI_API_KEY=

# Deployment name for GPT-5 Pro (or your model deployment)
AZURE_EXPERT_DEPLOYMENT=gpt-5-pro

# Notes:
# - Uses Azure OpenAI v1 API endpoint (latest features, no api-version needed)
# - If AZURE_OPENAI_API_KEY is not set, AgentHub will attempt Entra ID (Azure AD) authentication
# - Entra ID requires proper Azure credentials configured in your environment
# - See: https://learn.microsoft.com/azure/ai-foundry/openai/how-to/responses

# Persistence Configuration (optional)
# Enables JSON snapshot persistence to survive hub restarts
# If not enabled, all state is lost when the hub restarts

# Enable/disable persistence (default: false)
PERSISTENCE_ENABLED=false

# Path to save state snapshots (default: .agenthub/state.json)
PERSISTENCE_PATH=.agenthub/state.json

# Auto-save interval in milliseconds (default: 60000 = 1 minute)
PERSISTENCE_INTERVAL=60000

# Auto-restore state on startup (default: true)
PERSISTENCE_AUTO_RESTORE=true

# Notes:
# - Persistence uses atomic writes (temp file + rename) for crash safety
# - Expired intents/leases are automatically filtered out on restore
# - Session bindings are ephemeral and not persisted
# - State is saved on shutdown (Ctrl+C)
