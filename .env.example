# AgentHub Environment Configuration

# Server Configuration
PORT=3333
HOST=localhost

# Filesystem Watcher (optional)
# Path to watch for file changes - set this to your project root
# If not set, filesystem watching will be disabled
WATCH_ROOT=

# Azure OpenAI Configuration (optional)
# Required for expert escalation (x.ask operation)
# If not set, expert escalation will return an error

# Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=

# API Key authentication (recommended for development)
AZURE_OPENAI_API_KEY=

# Deployment name for GPT-5 Pro (or your model deployment)
AZURE_EXPERT_DEPLOYMENT=gpt-5-pro

# Notes:
# - If AZURE_OPENAI_API_KEY is not set, AgentHub will attempt Entra ID (Azure AD) authentication
# - Entra ID requires proper Azure credentials configured in your environment
# - See: https://learn.microsoft.com/azure/developer/javascript/sdk/authentication/overview
