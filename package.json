{
  "name": "@propstreet/agenthub",
  "version": "0.1.0",
  "description": "Lean MCP orchestrator for coordinating multiple coding agents",
  "type": "module",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "bin": {
    "agenthub": "./dist/server/index.js",
    "agentboard": "./dist/dashboard/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "agentboard": "tsx src/dashboard/index.ts",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "orchestrator",
    "multi-agent",
    "coordination"
  ],
  "author": "Propstreet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/propstreet/agenthub"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.21.1",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "micromatch": "^4.0.8",
    "nanoid": "^5.1.6",
    "openai": "^6.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.5",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
